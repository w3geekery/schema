{
  "name": "@zerobias-org/schema-zerobias-zerobias-base",
  "description": "Base Schema for Zerobias Platform.",
  "version": "2.0.3",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "auditmation": {
    "package": "zerobias.zerobias.base.schema",
    "dataloader-version": "1.0.0",
    "import-artifact": "schema",
    "imports": [
      "zerobias.zerobias.platform.schema"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/schema.git",
    "directory": "package/zerobias/base"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "classes/**",
    "documents/**",
    "enums/**",
    "interfaces/**",
    "fields/**",
    "catalog.yml",
    "README.md"
  ],
  "scripts": {
    "nx:prepublish": "../../../../scripts/prepublish.sh",
    "correct:deps": "tsx ../../../../scripts/correctDeps.ts",
    "validate": "tsx ../../../../scripts/validate.ts"
  },
  "dependencies": {
    "@zerobias-com/schema-zerobias-zerobias-platform": "latest",
    "@zerobias-com/tag-zerobias-global-tags": "^1.0.0"
  }
}
