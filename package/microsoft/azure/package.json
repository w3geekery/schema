{
  "name": "@zerobias-org/schema-microsoft-azure",
  "description": "Suite level schema for Microsoft Azure",
  "version": "3.0.0",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/schema.git",
    "directory": "package/microsoft/azure/"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "classes/**",
    "interfaces/**",
    "fields/**",
    "enums/**",
    "catalog.yml",
    "README.md"
  ],
  "dependencies": {
    "@zerobias-com/schema-zerobias-zerobias-platform": "latest",
    "@zerobias-org/schema-zerobias-zerobias-base": "latest",
    "@zerobias-org/suite-microsoft-azure": "latest"
  },
  "zerobias": {
    "package": "microsoft.azure.schema",
    "dataloader-version": "1.0.0",
    "import-artifact": "schema",
    "imports": [
      "zerobias.zerobias.platform.schema",
      "zerobias.zerobias.base.schema"
    ]
  }
}
