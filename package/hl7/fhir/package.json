{
  "name": "@zerobias-org/schema-hl7-fhir",
  "version": "2.0.1",
  "description": "AuditgraphDB schema for HL7 FHIR R4 healthcare resources",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/schema.git",
    "directory": "package/hl7/fhir/"
